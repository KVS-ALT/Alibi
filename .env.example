# Optional: HTTP listen port. Default: 3001.
# PORT=

# Optional: HTTP listen host. Default: loopback outside production.
# HOST=

# Optional: runtime mode; production enables Secure cookies and public bind default.
# NODE_ENV=

# Optional: local Render task execution. Leave unset for the working local-demo runner.
# RENDER_USE_LOCAL_DEV=

# Optional: loopback Render task-server URL used only in local Render mode.
# RENDER_LOCAL_DEV_URL=

# Optional: registered local Render root task name.
# RENDER_BUILD_TASK=
