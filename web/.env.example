LIVE_PROVIDER_CALLS_ENABLED=true

# LLM: any OpenAI-compatible endpoint. Gemini (recommended):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_REASONING_EFFORT=low
LLM_CONCURRENCY=8
# Featherless instead: LLM_BASE_URL=https://api.featherless.ai/v1, LLM_MODEL=Qwen/Qwen2.5-7B-Instruct,
# LLM_CONCURRENCY=4, unset LLM_REASONING_EFFORT

SPEECHMATICS_API_KEY=
SPEECHMATICS_ENABLED=true
ALIBI_LOCAL_PROFILE=true
# DATABASE_URL=
