LIVE_PROVIDER_CALLS_ENABLED=true

# LLM: Featherless. DeepSeek-V3.2 writes best but uses all 4 plan units (one call at a time, ~15s each);
# Qwen2.5-7B (default) is fast: ~7s per call, 4 in parallel. For DeepSeek: FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V3.2, LLM_CONCURRENCY=1.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_CONCURRENCY=4
# Names you plan to say, so speech recognition spells them right:
SPEECHMATICS_VOCAB=LeaseLens,Standup
# Any OpenAI-compatible provider instead: set LLM_BASE_URL, LLM_API_KEY, LLM_MODEL (+ optional LLM_FALLBACK_MODEL, LLM_REASONING_EFFORT)

SPEECHMATICS_API_KEY=
SPEECHMATICS_ENABLED=true
ALIBI_LOCAL_PROFILE=true
# DATABASE_URL=
# Pin one portfolio template (showcase, lowercase or geist); otherwise the model picks.
# ALIBI_TEMPLATE=showcase
