{
  "name": "larp-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json && vite build --config vite.server.config.ts",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "dev:server": "vite build --config vite.server.config.ts && node --watch dist-server/index.js",
    "workflows:dev": "render workflows dev -- node dist-server/workflows.js",
    "workflows:start": "node dist-server/workflows.js",
    "build:candidate": "tsc -b && vite build --mode candidate && tsc -p tsconfig.server.json && vite build --config vite.server.config.ts --mode candidate",
    "start:candidate": "node --env-file-if-exists=.env dist-server-candidate/index.js --candidate --no-live-providers"
  },
  "dependencies": {
    "@renderinc/sdk": "1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
