# REQUIRED for the chosen real conversation flow. Fill dedicated keys locally.
FEATHERLESS_API_KEY=
SPEECHMATICS_API_KEY=
GENERATION_PROVIDER=featherless
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
SPEECH_PROVIDER=speechmatics
SPEECHMATICS_ENABLED=true
LIVE_PROVIDER_CALLS_ENABLED=false
# Fixed endpoint: https://api.featherless.ai/v1/chat/completions (not an OpenAI credential).
# Positive live-test quotas are explicit runtime arguments, not recurring-use approval.
# Required only for an approved private interactive test:
# INTERACTIVE_TEST_TOKEN= (random 64-character hex capability, operator generated)
# INTERACTIVE_TEST_EXPIRES_AT= (fixed UTC ISO timestamp, at most 15 minutes ahead at startup)

# Other runtime settings and alternative/extra capabilities follow.
# Optional: HTTP listen port. Default: 3001.
# PORT=

# Optional: HTTP listen host. Default: loopback outside production.
# HOST=

# Optional: runtime mode; production enables Secure cookies and public bind default.
# NODE_ENV=

# Optional: local Render task execution. Leave unset for the working local-demo runner.
# RENDER_USE_LOCAL_DEV=

# Optional: loopback Render task-server URL used only in local Render mode.
# RENDER_LOCAL_DEV_URL=

# Optional: registered local Render root task name.
# RENDER_BUILD_TASK=

# REQUIRED for any real provider call: separate live approval, runtime flag and positive request quotas.
# LIVE_PROVIDER_CALLS_ENABLED=

# REQUIRED for real model generation: choose openai. demo is offline synthetic generation.
# GENERATION_PROVIDER=

# REQUIRED for real OpenAI model generation: server-side OPENAI_API_KEY.
# OPENAI_API_KEY=

# Optional. Approved model: gpt-6-sol.
# OPENAI_MODEL=

# REQUIRED for real Speechmatics speech: choose speechmatics. Choose only one speech provider.
# SPEECH_PROVIDER=

# ALTERNATIVE speech provider only: ELEVENLABS_API_KEY is required if ElevenLabs is selected.
# ELEVENLABS_API_KEY=

# Optional. Provider retention requires separate explicit consent.
# ELEVENLABS_ALLOW_LOGGING=

# REQUIRED for real Speechmatics speech: explicit SPEECHMATICS_ENABLED=true, after approval.
# SPEECHMATICS_ENABLED=

# REQUIRED for real Speechmatics realtime: server-side SPEECHMATICS_API_KEY.
# SPEECHMATICS_API_KEY=

# EXTRA CAPABILITY: explicit EMAIL_SEND_ENABLED is required for approved email delivery.
# EMAIL_SEND_ENABLED=

# EXTRA email capability: this Agentboxd setting is required when email delivery is enabled.
# AGENTBOXD_API_KEY=

# EXTRA email capability: this Agentboxd setting is required when email delivery is enabled.
# AGENTBOXD_INBOX_ID=

# Required for approved sending: explicit recipient allowlist.
# EMAIL_ALLOWED_RECIPIENTS=

# Required for approved sending: private durable JSON outbox path.
# EMAIL_OUTBOX_PATH=

# Optional non-secret local ready-tone flag; false by default.
# VITE_READY_CUE=
